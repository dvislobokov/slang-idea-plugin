<!-- Loaded only when com.intellij.modules.ultimate is present (the platform LSP API). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider implementation="org.zell.idea.lsp.ZellLspServerSupportProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="org.zell.idea.lsp.ZellLspRestartAction$ToolchainListener"
                  topic="org.zell.idea.toolchain.ZellToolchain$Listener"/>
    </applicationListeners>

    <actions>
        <action id="org.zell.idea.lsp.Restart" class="org.zell.idea.lsp.ZellLspRestartAction"
                text="Restart Zell Language Server" description="Stop zell-lsp and start it again">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
